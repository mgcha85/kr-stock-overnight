# Environment Configuration (.env.example)
ENV_TYPE=dev
PORT=8080
LOG_LEVEL=info

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Seed Money & Trading Settings
SEED_CAPITAL=10000000
# paper = DB fills only (default). live = Kiwoom real orders (kt10000/kt10001).
TRADING_MODE=paper
TOP_K_TRADES=3
FEE_RATE=0.0023

# Target Deployment / Dashboard API Configuration
DASHBOARD_API_URL=http://146.56.115.71:8082/api/backtest
PAPER_TRADING_API_URL=http://146.56.115.71:8081

# Google API Key for AI Models
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.0-flash

# Database Paths
JUDAL_DB_PATH=/mnt/data/projects/marketMosaic/backend/data/judal.db
SECTOR_DB_PATH=/mnt/data/finance/candles/KO/sector_info.db
BACKTEST_DB_PATH=/mnt/data/finance/backtest_results.db
PAPER_DB_PATH=/app/data/paper_trading.db

# Kiwoom REST OpenAPI (real HTS 조건검색)
KIWOOM_LIVE=1
KIWOOM_ACCEPT_MOCK=0
KIWOOM_CONDITION_NAME=종가베팅
APP_DOMAIN=https://api.kiwoom.com
APP_MOCK_DOMAIN=https://mockapi.kiwoom.com
WS_URL=wss://api.kiwoom.com:10000/api/dostk/websocket
WS_URL_MOCK=wss://mockapi.kiwoom.com:10000/api/dostk/websocket
APP_KEY=your_kiwoom_app_key
SECRET_KEY=your_kiwoom_secret_key
KIWOOM_APP_KEY=your_kiwoom_app_key
KIWOOM_SECRET_KEY=your_kiwoom_secret_key
ACC_NO=your_account_number
USE_MOCK=false
KIWOOM_TOKEN_PATH=/app/data/kiwoom_access_token.json
