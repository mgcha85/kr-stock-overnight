# Environment Configuration (.env.example)
ENV_TYPE=dev
PORT=8080
LOG_LEVEL=info

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Seed Money & Trading Settings
SEED_CAPITAL=10000000
TOP_K_TRADES=3
FEE_RATE=0.0023

# Target Deployment / Dashboard API Configuration
DASHBOARD_API_URL=http://146.56.115.71:8082/api/backtest
PAPER_TRADING_API_URL=http://146.56.115.71:8081

# Google API Key for AI Models
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.0-flash

# Database Paths
JUDAL_DB_PATH=/mnt/data/projects/marketMosaic/backend/data/judal.db
SECTOR_DB_PATH=/mnt/data/finance/candles/KO/sector_info.db
BACKTEST_DB_PATH=/mnt/data/finance/backtest_results.db
PAPER_DB_PATH=/app/data/paper_trading.db
